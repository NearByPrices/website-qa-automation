# Target site key (must match a key in config/sites/)
TARGET_SITE=nbp

# NBP base URL — required for NBP tests
NBP_BASE_URL=

# Google Sheets ID (from the spreadsheet URL)
GOOGLE_SHEETS_ID=

# Google service account JSON credentials (inline JSON string, base64-encoded)
# Generate via: base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# Crawl limits
AUDIT_MAX_PAGES=50
AUDIT_CONCURRENCY=2
AUDIT_TIMEOUT_MS=30000

# Optional: override per-check timeouts (ms)
PLAYWRIGHT_TIMEOUT_MS=30000
LIGHTHOUSE_TIMEOUT_MS=60000

# CI environment flag — set to "true" in GitHub Actions
CI=false
